# Auth (NextAuth v5)
AUTH_SECRET=                        # random string — generate with `openssl rand -base64 32`
NEXTAUTH_URL=http://localhost:3000
AUTH_GITHUB_ID=                     # GitHub OAuth App client ID
AUTH_GITHUB_SECRET=                 # GitHub OAuth App client secret

# Database (Railway PostgreSQL)
DATABASE_URL=                       # postgresql://user:pass@host:port/db

# Redis (Upstash — REST API, used for multi-instance WS pub/sub)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# AI
ANTHROPIC_API_KEY=                  # used for all Claude Haiku calls
OPENAI_API_KEY=                     # reserved, not currently called

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000     # Next.js frontend origin
NEXT_PUBLIC_WS_URL=http://localhost:3001      # WebSocket server origin (client-side)
FRONTEND_URL=http://localhost:3000            # allowed CORS origin on the WS server

# Admin
ADMIN_SECRET=                       # reserved for future admin-only endpoints
